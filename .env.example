OANDA_API_KEY=your-oanda-v20-bearer-token
OANDA_ACCOUNT_ID=
OANDA_ENV=practice
FOREX_DB_PATH=data/forex_data.sqlite3

# ── Daily ML predictions (read-only, from the sqlserver_copilot_forex repo) ──
# The dashboard mirrors forex_ml_predictions into SQLite and serves the Results
# box and Reconcile tab from there, so SQL Server is only contacted when the
# mirror is behind that weekday's 20:55 ET run.
SQL_SERVER=192.168.86.28,1444
SQL_DATABASE=stockdata_db
SQL_USERNAME=your-sql-login
SQL_PASSWORD=your-sql-password
SQL_DRIVER=ODBC Driver 17 for SQL Server
SQL_TRUSTED_CONNECTION=no

# Optional overrides
# ML_PREDICTIONS_TABLE=forex_ml_predictions
# ML_SYNC_MIN_INTERVAL_MINUTES=30
# ML_INITIAL_SYNC_DAYS=60
